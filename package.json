{
  "name": "mifiado",
  "version": "0.1.0",
  "private": true,
  "description": "MiFiado - plataforma de fiado para negocios de barrio en Chile",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "esbuild src/client.js --bundle --format=iife --target=es2020 --outfile=public/js/app.bundle.js",
    "postinstall": "npm run build",
    "start": "node server.js",
    "dev": "node --watch server.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "dotenv": "^16.4.7",
    "esbuild": "^0.25.0",
    "express": "^5.1.0",
    "html5-qrcode": "^2.3.8",
    "qrcode": "^1.5.4"
  }
}
